+  if (InterPrediction::nnProxyActive())
+  {
+    InterPrediction::NNPathScope nnScope(m_pcInterSearch, InterPrediction::NN_PATH_MRG_UPGRADE);
+    const int nSel = std::min<int>(numMergeSatdCand, (int) m_mergeItemList.size());
+    bool regDone[MRG_MAX_NUM_CANDS] = { false };
+    bool geoDone[MRG_MAX_NUM_CANDS] = { false };
+    auto regenRegular = [&](MergeItem *it, int k)
+    {
+      tempCS->initStructData(encTestMode.qp);
+      PredictionUnit *upu = getPuForInterPrediction(tempCS);
+      upu->dmvrImpreciseMv = false;
+      it->lumaPredReady = it->chromaPredReady = false;
+      auto dst = it->getPredBuf(localUnitArea);
+      generateMergePrediction(localUnitArea, it, *upu, true, true, dst, false, false, mrgPredBufNoMvRefine[k], mrgPredBufNoCiip[k]);
+      regDone[k] = true;
+    };
+    // (a) regular candidates: selected REGULAR items regenerate in place, CIIP items need the regular buffers of their candidate
+    for (int i = 0; i < nSel; i++)
+    {
+      MergeItem *it = m_mergeItemList.getMergeItemInList(i);
+      if (it->mergeItemType == MergeItem::MergeItemType::REGULAR && !regDone[it->mergeIdx]) regenRegular(it, it->mergeIdx);
+    }
+    for (int i = 0; i < nSel; i++)
+    {
+      MergeItem *it = m_mergeItemList.getMergeItemInList(i);
+      if (it->mergeItemType == MergeItem::MergeItemType::CIIP && !regDone[it->mergeIdx])
+      {
+        tempCS->initStructData(encTestMode.qp);
+        PredictionUnit *upu = getPuForInterPrediction(tempCS);
+        MergeItem *tmp = m_mergeItemList.allocateNewMergeItem();
+        tmp->importMergeInfo(mergeCtx, it->mergeIdx, MergeItem::MergeItemType::REGULAR, *upu);
+        regenRegular(tmp, it->mergeIdx);
+        m_mergeItemList.releaseMergeItem(tmp);
+      }
+    }
+    // (b) GPM candidate buffers (as in prepareGpmComboList)
+    for (int i = 0; i < nSel; i++)
+    {
+      MergeItem *it = m_mergeItemList.getMergeItemInList(i);
+      if (it->mergeItemType != MergeItem::MergeItemType::GPM) continue;
+      uint8_t splitDir; MergeIdxPair gidx; MergeItem::updateGpmIdx(it->mergeIdx, splitDir, gidx);
+      for (int j = 0; j < 2; j++)
+      {
+        const int c = gidx[j];
+        if (geoDone[c]) continue;
+        tempCS->initStructData(encTestMode.qp);
+        PredictionUnit *upu = getPuForInterPrediction(tempCS);
+        upu->mergeFlag = true;
+        upu->regularMergeFlag = false;
+        upu->cu->geoFlag = true;
+        gpmMergeCtx.setMergeInfo(*upu, c);
+        PU::spanMotionInfo(*upu, gpmMergeCtx);
+        m_pcInterSearch->motionCompensation(*upu, *geoBuffer[c], REF_PIC_LIST_X);
+        geoDone[c] = true;
+      }
+    }
+    // (c) item buffers that pass 1 filled with luma only (CIIP, MMVD, SbTMVP, affine, GPM)
+    for (int i = 0; i < nSel; i++)
+    {
+      MergeItem *it = m_mergeItemList.getMergeItemInList(i);
+      if (it->mergeItemType == MergeItem::MergeItemType::REGULAR) continue;
+      tempCS->initStructData(encTestMode.qp);
+      PredictionUnit *upu = getPuForInterPrediction(tempCS);
+      it->lumaPredReady = false;
+      CHECK(it->chromaPredReady, "yvvyee: unexpected chroma-ready item in proxy upgrade");
+      auto dst = it->getPredBuf(localUnitArea);
+      PelUnitBuf *b1 = nullptr, *b2 = nullptr;
+      if (it->mergeItemType == MergeItem::MergeItemType::CIIP) b1 = mrgPredBufNoMvRefine[it->mergeIdx];
+      if (it->mergeItemType == MergeItem::MergeItemType::GPM) { uint8_t sd; MergeIdxPair g; MergeItem::updateGpmIdx(it->mergeIdx, sd, g); b1 = geoBuffer[g[0]]; b2 = geoBuffer[g[1]]; }
+      generateMergePrediction(localUnitArea, it, *upu, true, false, dst, false, false, b1, b2);
+    }
+  }
+  InterPrediction::NNPathScope nnScopeFinal(m_pcInterSearch, InterPrediction::NN_PATH_MRG_FINAL);   // yvvyee: RD pass, full model
+
   // 2. Pass: RD checking 
   tempCS->initStructData(encTestMode.qp);
   m_CABACEstimator->getCtx() = ctxStart;
