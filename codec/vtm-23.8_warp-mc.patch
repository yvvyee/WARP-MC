+#endif
+
+#if GDR_ENABLED
+      if (allOk)
+#else
+      if (costBi <= uiCost[0] && costBi <= uiCost[1])
+#endif
+      {
+        CHECK(iRefIdxBi[0] < 0, "Invalid picture reference index");
+        CHECK(iRefIdxBi[1] < 0, "Invalid picture reference index");
+        uiLastMode = 2;
+        pu.mv    [REF_PIC_LIST_0] = cMvBi[0];
