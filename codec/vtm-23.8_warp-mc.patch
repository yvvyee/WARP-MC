+  for (int i = 0; i < 4; i++) { const Arr &a = A(ln[i]); if (a.v.size() < need[i]) { delete p; return fail("LUT size"); } *offs[i] = (int) lut.size(); for (long long v : a.v) lut.push_back((int) v); }
