+    const Arr &wa = A(nm + "_w"), &ba = A(nm + "_b_q14"); if (wa.shape.size() < 2) return false;
+    L.Co = (int) wa.shape[0]; L.Ci = (int) wa.shape[1]; L.we = (int) Sv(nm + "_wexp"); L.oexp = (int) Sv(nm + "_oexp");
