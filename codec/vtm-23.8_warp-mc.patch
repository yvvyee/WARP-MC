+void DeblockingFilter::resetBsAndEdgeFilter(const EdgeDir edgeDir)
+{
+  std::fill_n(m_edgeStrengths[edgeDir].data(), m_edgeStrengths[edgeDir].size(), EdgeStrengths());
+}
