-  else
-  {
-    const int currPOC    = slice.getPOC();
-    const int colPOC     = colSlice.getPOC();
-    const int colRefPOC  = colSlice.getRefPOC(eColRefPicList, colRefIdx);
-    const int currRefPOC = slice.getRefPic(eRefPicList, refIdx)->getPOC();
