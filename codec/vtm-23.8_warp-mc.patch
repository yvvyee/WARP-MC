+  }
+  out.assign(ny * nx, 0);
+  for (int t = 0; t < ny; t++)
+  {
+    const int p16 = (r0 + t) * 16 + sy16; const int i0 = (int) fdiv_floor(p16, 16), f = p16 - 16 * i0;
