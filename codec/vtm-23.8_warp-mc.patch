+  {
+    const int sy = reflI(py - 1, Hh);
+    for (int px = 0; px < Wp; px++)
+    {
+      const int16_t *s = a + (sy * Ww + reflI(px - 1, Ww)) * Cs; uint32_t *h = XH + (py * Wp + px) * NP, *l = XL + (py * Wp + px) * NP;
