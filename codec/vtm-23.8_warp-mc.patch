+// yvvyee: 반사 패딩 (Hh+2)x(Ww+2) 와 상·하위 바이트 채널 쌍 묶음. a: [Hh*Ww][Cs] int16, 채널 c >= Cs 는 0
+void packPad(const int16_t *a, int Hh, int Ww, int Cs, int NP, uint32_t *XH, uint32_t *XL)
+{
+  const int Wp = Ww + 2;
