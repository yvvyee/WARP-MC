-    return false;
-  }
-
-
-  // Scale the vector.
-  Mv cColMv = mi.mv[eColRefPicList];
-  cColMv.setHor(roundMvComp(cColMv.getHor()));
-  cColMv.setVer(roundMvComp(cColMv.getVer()));
-
-  if (isCurrRefLongTerm /*|| isColRefLongTerm*/)
-  {
-    rcMv = cColMv;
