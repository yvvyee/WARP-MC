+__attribute__((target("avx2"))) inline __m256i rshr64v(__m256i x, int sh)
+{
+  x = _mm256_add_epi64(x, _mm256_set1_epi64x(1LL << (sh - 1))); const __m256i m = _mm256_cmpgt_epi64(_mm256_setzero_si256(), x);
