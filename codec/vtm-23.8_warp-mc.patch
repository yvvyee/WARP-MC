+uint32_t CU::getNumPUs( const CodingUnit& cu )
+{
+  uint32_t cnt = 0;
+  PredictionUnit *pu = cu.firstPU;
+
+  do
+  {
+    cnt++;
+  } while( ( pu != cu.lastPU ) && ( pu = pu->next ) );
+
+  return cnt;
+}
