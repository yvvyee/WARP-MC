+      pu.mvValid[REF_PIC_LIST_0] = true;
+      pu.mvValid[REF_PIC_LIST_1] = true;
+    }
+#endif
+      // Set Motion Field
+
+      cMv[1]     = mvValidList1;
+#if GDR_ENABLED
+      if (isEncodeGdrClean)
