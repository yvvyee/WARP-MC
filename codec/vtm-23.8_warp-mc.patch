+template <int OB> __attribute__((target("avx2,avxvnni"))) void conv3x3Vnni(const C3L &L, const uint32_t *XH, const uint32_t *XL, int Wp, int y0, int x0, int ny, int nx, int16_t *o16, int64_t *o64, int ostr)
