-  if (isLuma(compID))
-  {
-    bdpcmAllowed &= (cu.lwidth() <= transformSkipMaxSize && cu.lheight() <= transformSkipMaxSize);
-  }
-  else
-  {
-    bdpcmAllowed &= (cu.chromaSize().width <= transformSkipMaxSize && cu.chromaSize().height <= transformSkipMaxSize)
-                    && !cu.colorTransform;
-  }
-  return bdpcmAllowed;
