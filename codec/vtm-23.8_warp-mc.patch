+double InterSearch::xGetMEDistortionWeight(uint8_t bcwIdx, RefPicList eRefPicList)
+{
+  if( bcwIdx != BCW_DEFAULT )
+  {
+    return (double) abs(getBcwWeight(bcwIdx, eRefPicList)) / BCW_WEIGHT_BASE;
+  }
+  else
+  {
+    return 0.5;
+  }
+}
