-void DeblockingFilter::resetFilterLengths()
-{
-  resetBsAndEdgeFilter(EdgeDir::VER);
-  resetBsAndEdgeFilter(EdgeDir::HOR);
-  clearFilterLengthAndTransformEdge();
-}
