-
-  // Generate @ 1,1
-  intPtr = m_filteredBlockTmp[1][0] + (halfFilterSize-1) * intStride;
-  dstPtr = m_filteredBlock[1][1][0];
-  if (halfPelRef.getVer() == 0)
-  {
-    intPtr += intStride;
