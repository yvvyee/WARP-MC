-uint32_t InterSearch::xGetMvpIdxBits(int idx, int num)
-{
-  CHECK(idx < 0 || num < 0 || idx >= num, "Invalid parameters");
-
-  if (num == 1)
-  {
-    return 0;
-  }
-
-  uint32_t length   = 1;
-  int      temp     = idx;
-  if (temp == 0)
-  {
-    return length;
-  }
-
-  bool bCodeLast = (num - 1 > temp);
-
-  length += (temp - 1);
-
-  if( bCodeLast )
-  {
-    length++;
-  }
-
-  return length;
-}
