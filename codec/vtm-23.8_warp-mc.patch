-    if (isLuma(chType))
-    {
-      const int bsY =
-        CU::isIntra(cuP) && cuP.bdpcmMode != BdpcmMode::NONE && CU::isIntra(cuQ) && cuQ.bdpcmMode != BdpcmMode::NONE
-          ? 0
-          : 2;
-      return EdgeStrengths().setBoundaryStrength(COMPONENT_Y, bsY);
