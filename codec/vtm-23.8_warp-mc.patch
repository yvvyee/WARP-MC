-  if( iX1 >= sr.left && iX1 <= sr.right && iY1 >= sr.top && iY1 <= sr.bottom )
-  {
-    xTZSearchHelp( rcStruct, iX1, iY1, 0, 2 );
-  }
-
-  if( iX2 >= sr.left && iX2 <= sr.right && iY2 >= sr.top && iY2 <= sr.bottom )
