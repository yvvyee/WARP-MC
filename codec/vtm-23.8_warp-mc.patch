-      return;
-    }
-  }
-
-  while (cnt < maxNumMergeCand)
-  {
-    mrgCtx.mvFieldNeighbours[cnt][0].setMvField(Mv(0, 0), IBC_REF_IDX);
-    mrgCtx.interDirNeighbours[cnt] = 1;
-#if GDR_ENABLED
-    // GDR: zero mv(0,0)
