-#else
-    const bool found = addMergeHmvpCand(cs, mrgCtx, mrgCandIdx, maxNumMergeCand, cnt, isAvailableA1, miLeft,
-                                        isAvailableB1, miAbove, true, isGt4x4);
-#endif
-
-    if (found)
