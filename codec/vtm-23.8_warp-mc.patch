+        pu.cu->imv = 0;
+        PU::fillMvpCand(pu, eRefPicList, refIdx, currAMVPInfoQPel);
+        CHECK(currAMVPInfoPel.numCand <= 1, "Wrong")
+        for (int mvpIdxTemp = 0; mvpIdxTemp < 2; mvpIdxTemp++)
