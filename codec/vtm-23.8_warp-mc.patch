+    }
+  }
+  // LUTs
+  std::vector<int> lut; const char *ln[4] = { "lut_exp2_frac_q15", "lut_log2_mant_q10", "lut_recip_mant_q15", "lut_sigmoid_q15" }; int *offs[4] = { &p->lutExp, &p->lutLog, &p->lutRec, &p->lutSig };
